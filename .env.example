# ── Healthcare AI Assistant — Environment Variables ──

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=4

# Email / SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Server
HOST=0.0.0.0
PORT=8000
